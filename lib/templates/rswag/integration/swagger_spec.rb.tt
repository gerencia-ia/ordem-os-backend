# frozen_string_literal: true

require "swagger_helper"

<% tag_name = controller_class_name.titleize -%>
RSpec.describe "<%= tag_name %> API", type: :request, swagger_doc: "<%= api_version %>/swagger.yaml" do
  path "<%= api_route_path %>" do
    get "Lista <%= plural_resource_name.tr('_', ' ') %>" do
      tags "<%= tag_name %>"
      description "Retorna a lista de <%= plural_resource_name.tr('_', ' ') %> cadastrados."
      operationId "get<%= controller_class_name.delete(':') %>"
      produces "application/json"

      response "200", "Lista retornada com sucesso" do
        schema type: :array,
          items: {
            type: :object,
            properties: {
              id: { type: :integer, example: 1 }<%= attributes.any? ? "," : "" %>
<% attributes.each_with_index do |attr, idx| -%>
              <%= attr.column_name %>: <%= openapi_property_literal(attr) %><%= "," unless idx == attributes.size - 1 %>
<% end -%>
            }
          }
        run_test!
      end

      response "403", "Acesso negado" do
        schema type: :object
        run_test!
      end
    end

    post "Cadastra um novo <%= singular_resource_name.tr('_', ' ') %>" do
      tags "<%= tag_name %>"
      operationId "create<%= model_class_name.delete(':') %>"
      consumes "application/json"
      produces "application/json"

      parameter name: :<%= singular_resource_name %>_params, in: :body, schema: {
        type: :object,
        properties: {
          <%= singular_resource_name %>: {
            type: :object,
<% if attributes.any? -%>
            properties: {
<% attributes.each_with_index do |attr, idx| -%>
              <%= attr.column_name %>: <%= openapi_property_literal(attr) %><%= "," unless idx == attributes.size - 1 %>
<% end -%>
            },
            required: %w[<%= attributes.map(&:column_name).join(" ") %>]
<% else -%>
            properties: {}
<% end -%>
          }
        },
        required: %w[<%= singular_resource_name %>]
      }

      response "201", "Registro cadastrado com sucesso" do
        schema type: :object
        run_test!
      end

      response "403", "Acesso negado" do
        schema type: :object
        run_test!
      end

      response "422", "Erro de validação" do
        schema type: :object
        run_test!
      end
    end
  end

  path "<%= api_route_path %>/{id}" do
    parameter name: :id, in: :path, type: :integer, description: "ID único de <%= model_class_name %>", example: 1

    get "Visualiza detalhes de <%= singular_resource_name.tr('_', ' ') %>" do
      tags "<%= tag_name %>"
      operationId "get<%= model_class_name.delete(':') %>"
      produces "application/json"

      response "200", "Registro encontrado" do
        schema type: :object
        run_test!
      end

      response "403", "Acesso negado" do
        schema type: :object
        run_test!
      end

      response "404", "Registro não encontrado" do
        schema type: :object
        run_test!
      end
    end

    patch "Atualiza <%= singular_resource_name.tr('_', ' ') %>" do
      tags "<%= tag_name %>"
      operationId "update<%= model_class_name.delete(':') %>"
      consumes "application/json"
      produces "application/json"

      parameter name: :<%= singular_resource_name %>_update, in: :body, schema: {
        type: :object,
        properties: {
          <%= singular_resource_name %>: {
            type: :object,
<% if attributes.any? -%>
            properties: {
<% attributes.each_with_index do |attr, idx| -%>
              <%= attr.column_name %>: <%= openapi_property_literal(attr) %><%= "," unless idx == attributes.size - 1 %>
<% end -%>
            }
<% else -%>
            properties: {}
<% end -%>
          }
        }
      }

      response "200", "Registro atualizado" do
        schema type: :object
        run_test!
      end

      response "403", "Acesso negado" do
        schema type: :object
        run_test!
      end

      response "422", "Erro de validação" do
        schema type: :object
        run_test!
      end
    end

    delete "Remove <%= singular_resource_name.tr('_', ' ') %>" do
      tags "<%= tag_name %>"
      operationId "delete<%= model_class_name.delete(':') %>"
      produces "application/json"

      response "204", "Registro removido" do
        run_test!
      end

      response "403", "Acesso negado" do
        schema type: :object
        run_test!
      end
    end
  end
end
